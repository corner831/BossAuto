{
  "manifest_version": 3,
  "name": "BOSS直聘自动投递助手",
  "version": "0.2.10",
  "description": "登录 BOSS 直聘后，一键搜索职位、抓取岗位详情、用大模型判断匹配度并自动打招呼投递。仅在你本地浏览器会话中运行，不采集或上传任何账号信息。",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://www.zhipin.com/*", "https://api.deepseek.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "BOSS直聘自动投递助手",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/web/geek/job*"],
      "js": [
        "src/shared/utils.js",
        "src/shared/selectors.js",
        "src/shared/matcher.js",
        "src/shared/scoring.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/job_detail/*", "https://www.zhipin.com/web/geek/chat*"],
      "js": ["src/content/detail-guard.js"],
      "run_at": "document_idle"
    }
  ]
}
